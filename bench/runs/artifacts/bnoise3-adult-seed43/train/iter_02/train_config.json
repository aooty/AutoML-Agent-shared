{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 900,
    "learning_rate": 0.04,
    "max_depth": 7,
    "subsample": 0.9,
    "reg_lambda": 2.0,
    "scale_pos_weight": 3.18
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench/runs/artifacts/bnoise3-adult-seed43/train/iter_01/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}