{
  "model": "mlp",
  "hyperparams": {
    "hidden_layer_sizes": [
      256,
      128,
      64
    ],
    "alpha": 0.0003,
    "learning_rate_init": 0.0008,
    "batch_size": 256,
    "max_iter": 300,
    "early_stopping": true
