  "seed": 42,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench\\runs\\artifacts\\bar65llm-adult-seed42\\train\\iter_02\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}