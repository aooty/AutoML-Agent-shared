{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 1200,
    "learning_rate": 0.03,
    "max_depth": 5,
    "subsample": 0.8,
    "colsample_bytree": 0.7,
    "min_child_weight": 5,
    "reg_lambda": 3.0,
    "scale_pos_weight": 3.18,
    "early_stopping_rounds": 60
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench\\runs\\artifacts\\bar65llm-adult-seed42\\train\\iter_01\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}