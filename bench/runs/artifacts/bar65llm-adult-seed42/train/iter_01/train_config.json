{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 500,
    "learning_rate": 0.06,
    "max_leaf_nodes": 63,
    "l2_regularization": 1.0,
    "min_samples_leaf": 40,
    "class_weight": "balanced",
    "early_stopping": false
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}