{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 800,
    "learning_rate": 0.04,
    "max_leaf_nodes": 15,
    "max_depth": 6,
    "min_samples_leaf": 40,
    "l2_regularization": 3.0,
    "class_weight": "balanced",
    "early_stopping": false
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench/runs/artifacts/bnoise2-adult-seed43/train/iter_01/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}