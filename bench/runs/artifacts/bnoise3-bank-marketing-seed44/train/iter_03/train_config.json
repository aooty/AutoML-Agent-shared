{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 600,
    "learning_rate": 0.04,
    "max_depth": 5,
    "subsample": 0.8,
    "reg_lambda": 5.0,
    "scale_pos_weight": 10.0
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench/runs/artifacts/bnoise3-bank-marketing-seed44/train/iter_01/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}