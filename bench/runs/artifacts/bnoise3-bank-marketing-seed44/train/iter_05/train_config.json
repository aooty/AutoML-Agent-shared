{
  "model": "random_forest",
  "hyperparams": {
    "n_estimators": 800,
    "min_samples_leaf": 2,
    "class_weight": "balanced_subsample"
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 3,
    "path": "bench/runs/artifacts/bnoise3-bank-marketing-seed44/train/iter_03/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}