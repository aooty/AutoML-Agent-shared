{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 700,
    "learning_rate": 0.04,
    "max_depth": 6,
    "subsample": 0.8,
    "reg_lambda": 3.0,
    "scale_pos_weight": 8.0
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench/runs/artifacts/bnoise3-bank-marketing-seed44/train/iter_01/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}