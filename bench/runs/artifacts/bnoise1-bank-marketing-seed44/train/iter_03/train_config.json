{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 1500,
    "learning_rate": 0.03,
    "max_depth": 6,
    "min_child_weight": 5,
    "subsample": 0.8,
    "colsample_bytree": 0.6,
    "reg_lambda": 5.0,
    "scale_pos_weight": 7.0,
    "early_stopping_rounds": 60
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench/runs/artifacts/bnoise1-bank-marketing-seed44/train/iter_02/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}