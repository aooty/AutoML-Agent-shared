{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 400,
    "learning_rate": 0.05,
    "max_leaf_nodes": 15,
    "l2_regularization": 3.0,
    "min_samples_leaf": 40,
    "early_stopping": true,
    "validation_fraction": 0.1,
    "n_iter_no_change": 30,
    "class_weight": {
      "0": 1.0,
      "1": 6.0
    },
    "random_state": 42
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench\\runs\\artifacts\\llm-speeddating-seed42\\train\\iter_01\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}