{
  "model": "random_forest",
  "hyperparams": {
    "n_estimators": 800,
    "min_samples_leaf": 1,
    "min_samples_split": 2,
    "class_weight": "balanced_subsample",
    "n_jobs": -1,
    "bootstrap": true,
    "random_state": 44
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 3,
    "path": "bench/runs/artifacts/bnoise2-bank-marketing-seed44/train/iter_03/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}