{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 600,
    "learning_rate": 0.04,
    "max_leaf_nodes": 15,
    "min_samples_leaf": 40,
    "l2_regularization": 5.0,
    "early_stopping": false,
    "class_weight": {
      "0": 1.0,
      "1": 9.0
    }
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench/runs/artifacts/bnoise2-bank-marketing-seed44/train/iter_01/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}