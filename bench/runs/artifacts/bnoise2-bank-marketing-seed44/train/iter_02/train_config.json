{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 1200,
    "learning_rate": 0.03,
    "max_depth": 8,
    "min_child_weight": 2,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_lambda": 2.0,
    "reg_alpha": 0.5,
    "scale_pos_weight": 7.5
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench/runs/artifacts/bnoise2-bank-marketing-seed44/train/iter_01/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}