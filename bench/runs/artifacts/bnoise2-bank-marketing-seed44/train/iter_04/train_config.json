{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 900,
    "learning_rate": 0.025,
    "max_leaf_nodes": 24,
    "min_samples_leaf": 25,
    "l2_regularization": 2.0,
    "max_bins": 255,
    "early_stopping": false,
    "class_weight": {
      "0": 1.0,
      "1": 8.2
    }
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 3,
    "path": "bench/runs/artifacts/bnoise2-bank-marketing-seed44/train/iter_03/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}