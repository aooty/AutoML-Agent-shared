{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 1200,
    "learning_rate": 0.03,
    "max_depth": 5,
    "min_child_weight": 8,
    "subsample": 0.85,
    "colsample_bytree": 0.8,
    "reg_lambda": 8.0,
    "reg_alpha": 0.5,
    "scale_pos_weight": 7.5,
    "early_stopping_rounds": 60
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 4,
    "path": "bench/runs/artifacts/bnoise2-speeddating-seed44/train/iter_04/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}