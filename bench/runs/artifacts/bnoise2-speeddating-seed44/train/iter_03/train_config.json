{
  "model": "mlp",
  "hyperparams": {
    "hidden_layer_sizes": [
      128,
      64
    ],
    "alpha": 0.0003,
    "learning_rate_init": 0.0003,
    "batch_size": 128,
    "max_iter": 400,
    "early_stopping": true
  },
  "preprocessing": {
    "impute": "median",
    "scale": true,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench/runs/artifacts/bnoise2-speeddating-seed44/train/iter_02/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}