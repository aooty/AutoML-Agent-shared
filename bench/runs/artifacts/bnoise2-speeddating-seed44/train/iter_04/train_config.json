{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 800,
    "learning_rate": 0.04,
    "max_depth": 4,
    "min_child_weight": 10,
    "subsample": 0.8,
    "colsample_bytree": 0.6,
    "reg_lambda": 10.0,
    "reg_alpha": 1.0,
    "scale_pos_weight": 5.07,
    "early_stopping_rounds": 50
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench/runs/artifacts/bnoise2-speeddating-seed44/train/iter_02/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}