{
  "model": "random_forest",
  "hyperparams": {
    "n_estimators": 600,
    "max_features": 0.4,
    "min_samples_leaf": 1,
    "min_samples_split": 2,
    "bootstrap": true,
    "n_jobs": -1,
    "random_state": 42
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/house_sales.csv",
    "target_column": "price"
  },
  "metric": "r2",
  "task": "regression",
  "seed": 42,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench\\runs\\artifacts\\spgon-house_sales-seed42\\train\\iter_01\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}