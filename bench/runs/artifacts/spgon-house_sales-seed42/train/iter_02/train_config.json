{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 3000,
    "learning_rate": 0.03,
    "max_leaf_nodes": 31,
    "max_depth": 8,
    "min_samples_leaf": 40,
    "l2_regularization": 10.0,
    "max_bins": 255,
    "early_stopping": true,
    "validation_fraction": 0.1,
    "n_iter_no_change": 60
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/house_sales.csv",
    "target_column": "price"
  },
  "metric": "r2",
  "task": "regression",
  "seed": 42,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench\\runs\\artifacts\\spgon-house_sales-seed42\\train\\iter_01\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}