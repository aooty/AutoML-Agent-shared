{
  "model": "hist_gbdt",
  "hyperparams": {
    "learning_rate": 0.03,
    "max_iter": 1500,
    "max_leaf_nodes": 15,
    "min_samples_leaf": 40,
    "l2_regularization": 5.0,
    "max_bins": 255,
    "early_stopping": true,
    "validation_fraction": 0.1,
    "n_iter_no_change": 40,
    "class_weight": "balanced"
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 3,
    "path": "bench\\runs\\artifacts\\bar65llm-adult-seed44\\train\\iter_03\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}