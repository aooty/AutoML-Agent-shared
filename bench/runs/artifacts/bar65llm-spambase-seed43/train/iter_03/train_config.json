{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 900,
    "learning_rate": 0.05,
    "max_depth": 6,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 1,
    "reg_lambda": 1.0,
    "scale_pos_weight": 1.3
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench\\runs\\artifacts\\bar65llm-spambase-seed43\\train\\iter_01\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}