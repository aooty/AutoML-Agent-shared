{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 150,
    "learning_rate": 0.1
  },
  "preprocessing": {
    "impute": "median"
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "memory_limit_mb": 2048
}