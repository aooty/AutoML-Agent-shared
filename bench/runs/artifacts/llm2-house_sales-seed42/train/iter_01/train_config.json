{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 600,
    "learning_rate": 0.06,
    "max_leaf_nodes": 63,
    "max_depth": 8,
    "min_samples_leaf": 20,
    "l2_regularization": 1.0,
    "early_stopping": false,
    "random_state": 42
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/house_sales.csv",
    "target_column": "price"
  },
  "metric": "r2",
  "task": "regression",
  "seed": 42,
  "memory_limit_mb": 2048
}