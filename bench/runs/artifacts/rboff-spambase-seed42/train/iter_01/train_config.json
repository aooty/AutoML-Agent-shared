{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 500,
    "learning_rate": 0.06,
    "max_leaf_nodes": 31,
    "min_samples_leaf": 15,
    "l2_regularization": 1.0,
    "early_stopping": true,
    "validation_fraction": 0.1,
    "n_iter_no_change": 30
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}