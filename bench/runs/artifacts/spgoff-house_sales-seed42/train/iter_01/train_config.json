{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 400,
    "learning_rate": 0.06,
    "max_leaf_nodes": 63,
    "min_samples_leaf": 15,
    "l2_regularization": 1.0,
    "early_stopping": true,
    "validation_fraction": 0.1,
    "n_iter_no_change": 30,
    "random_state": 42
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/house_sales.csv",
    "target_column": "price"
  },
  "metric": "r2",
  "task": "regression",
  "seed": 42,
  "memory_limit_mb": 2048
}