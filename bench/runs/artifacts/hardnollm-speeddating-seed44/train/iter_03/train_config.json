{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 400,
    "learning_rate": 0.03,
    "l2_regularization": 1.0,
    "max_depth": 6,
    "class_weight": {
      "0": 1.0,
      "1": 1.5
    }
  },
  "preprocessing": {
    "impute": "median"
  },
