    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench\\runs\\artifacts\\hardnollm-speeddating-seed44\\train\\iter_02\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}