{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 500,
    "learning_rate": 0.1,
    "max_depth": 12,
    "max_leaf_nodes": 255,
    "l2_regularization": 1.0,
    "class_weight": "balanced",
    "early_stopping": false
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/jungle-chess.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}