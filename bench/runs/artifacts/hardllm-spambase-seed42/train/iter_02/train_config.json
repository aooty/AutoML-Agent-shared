{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 900,
    "learning_rate": 0.03,
    "max_depth": 4,
    "subsample": 0.8,
    "reg_lambda": 3.0
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench\\runs\\artifacts\\hardllm-spambase-seed42\\train\\iter_01\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}