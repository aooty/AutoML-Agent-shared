{
  "model": "hist_gbdt",
  "hyperparams": {
    "learning_rate": 0.03,
    "max_iter": 900,
    "max_leaf_nodes": 15,
    "max_depth": 6,
    "min_samples_leaf": 10,
    "l2_regularization": 0.5,
    "early_stopping": false,
    "class_weight": {
      "0": 1.0,
      "1": 1.2
    },
    "random_state": 42
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "paired_baseline": {
    "iteration": 3,
    "path": "bench\\runs\\artifacts\\hardllm-spambase-seed42\\train\\iter_03\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}