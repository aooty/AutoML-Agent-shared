{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 900,
    "learning_rate": 0.03,
    "max_depth": 5,
    "min_child_weight": 3,
    "subsample": 0.8,
    "colsample_bytree": 0.7,
    "reg_lambda": 2.0,
    "reg_alpha": 0.5
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench/runs/artifacts/bnoise2-spambase-seed44/train/iter_01/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}