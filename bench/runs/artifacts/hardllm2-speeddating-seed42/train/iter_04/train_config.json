{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 1200,
    "learning_rate": 0.015,
    "max_leaf_nodes": 16,
    "min_samples_leaf": 30,
    "l2_regularization": 3.0,
    "max_features": 0.4,
    "early_stopping": false,
    "class_weight": {
      "0": 1.0,
      "1": 8.0
    }
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench\\runs\\artifacts\\hardllm2-speeddating-seed42\\train\\iter_02\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}