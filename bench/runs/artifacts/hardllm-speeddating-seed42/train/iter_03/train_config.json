{
  "model": "random_forest",
  "hyperparams": {
    "n_estimators": 800,
    "min_samples_leaf": 2,
    "class_weight": "balanced_subsample",
    "n_jobs": -1,
    "random_state": 42
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench\\runs\\artifacts\\hardllm-speeddating-seed42\\train\\iter_02\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}