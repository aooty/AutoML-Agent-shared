{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 400,
    "learning_rate": 0.03,
    "max_depth": 6,
    "class_weight": {
      "0": 1.0,
      "1": 2.25
    }
  },
  "preprocessing": {
    "impute": "median"
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench\\runs\\artifacts\\nollm2-adult-seed42\\train\\iter_02\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}