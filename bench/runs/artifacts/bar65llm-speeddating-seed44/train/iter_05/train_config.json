{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 1500,
    "learning_rate": 0.03,
    "max_depth": 5,
    "min_child_weight": 5,
    "subsample": 0.8,
    "colsample_bytree": 0.7,
    "reg_lambda": 5.0,
    "reg_alpha": 0.5,
    "scale_pos_weight": 5.07,
    "early_stopping_rounds": 60
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 4,
    "path": "bench\\runs\\artifacts\\bar65llm-speeddating-seed44\\train\\iter_04\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}