{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 800,
    "learning_rate": 0.05,
    "max_depth": 6,
    "subsample": 0.8,
    "reg_lambda": 2.0,
    "scale_pos_weight": 5.07
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench\\runs\\artifacts\\hardllm2-speeddating-seed43\\train\\iter_02\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}