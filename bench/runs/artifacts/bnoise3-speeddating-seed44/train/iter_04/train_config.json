{
  "model": "hist_gbdt",
  "hyperparams": {
    "learning_rate": 0.04,
    "max_iter": 400,
    "max_leaf_nodes": 16,
    "max_depth": 4,
    "l2_regularization": 5.0,
    "min_samples_leaf": 40,
    "max_features": 0.7,
    "class_weight": {
      "0": 1.0,
      "1": 6.0
    },
    "early_stopping": false
  },
  "preprocessing": {
    "impute": "none",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 2,
    "path": "bench/runs/artifacts/bnoise3-speeddating-seed44/train/iter_02/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}