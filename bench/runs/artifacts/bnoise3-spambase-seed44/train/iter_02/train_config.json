{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 1200,
    "learning_rate": 0.025,
    "max_depth": 4,
    "subsample": 0.8,
    "reg_lambda": 5.0,
    "early_stopping_rounds": 60
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench/runs/artifacts/bnoise3-spambase-seed44/train/iter_01/val_predictions.npz"
  },
  "memory_limit_mb": 2048
}