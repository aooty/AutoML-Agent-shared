{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 800,
    "learning_rate": 0.03,
    "max_leaf_nodes": 63,
    "l2_regularization": 0.5,
    "min_samples_leaf": 20,
    "early_stopping": true,
    "validation_fraction": 0.1,
    "n_iter_no_change": 40,
    "class_weight": {
      "0": 1.0,
      "1": 5.0
    },
    "random_state": 42
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "paired_baseline": {
    "iteration": 1,
    "path": "bench\\runs\\artifacts\\spgon-bank-marketing-seed42\\train\\iter_01\\val_predictions.npz"
  },
  "memory_limit_mb": 2048
}