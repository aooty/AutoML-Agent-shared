{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 150,
    "learning_rate": 0.1,
    "class_weight": "balanced"
  },
  "preprocessing": {
    "impute": "median"
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}
