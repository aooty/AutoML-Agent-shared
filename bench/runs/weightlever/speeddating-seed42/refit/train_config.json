{
  "model": "logreg",
  "hyperparams": {
    "max_iter": 400,
    "learning_rate": 0.05,
    "l2_regularization": 1.0,
    "max_depth": 4,
    "class_weight": {
      "0": 1.0,
      "1": 1.5
    }
  },
  "preprocessing": {
    "impute": "median"
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}
