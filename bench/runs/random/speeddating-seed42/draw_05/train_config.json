{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 1711,
    "learning_rate": 0.002227,
    "max_depth": 4,
    "max_leaf_nodes": 145,
    "l2_regularization": 3.881482
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}
