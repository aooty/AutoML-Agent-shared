{
  "model": "decision_tree",
  "hyperparams": {
    "max_depth": 26,
    "min_samples_leaf": 885,
    "class_weight": "balanced"
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": true,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/jungle-chess.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "memory_limit_mb": 2048
}
