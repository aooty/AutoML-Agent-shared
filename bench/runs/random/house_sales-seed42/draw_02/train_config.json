{
  "model": "linreg",
  "hyperparams": {},
  "preprocessing": {
    "impute": "most_frequent",
    "scale": true,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/house_sales.csv",
    "target_column": "price"
  },
  "metric": "r2",
  "task": "regression",
  "seed": 42,
  "memory_limit_mb": 2048
}
