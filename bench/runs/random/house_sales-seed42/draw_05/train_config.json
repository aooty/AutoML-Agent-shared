{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 3,
    "learning_rate": 0.030645,
    "max_depth": 45,
    "reg_lambda": 83.5942,
    "subsample": 0.990425
  },
  "preprocessing": {
    "impute": "most_frequent",
    "scale": true,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/house_sales.csv",
    "target_column": "price"
  },
  "metric": "r2",
  "task": "regression",
  "seed": 42,
  "memory_limit_mb": 2048
}
