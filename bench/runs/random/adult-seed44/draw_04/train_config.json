{
  "model": "knn",
  "hyperparams": {
    "n_neighbors": 15,
    "weights": "distance"
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "memory_limit_mb": 2048
}
