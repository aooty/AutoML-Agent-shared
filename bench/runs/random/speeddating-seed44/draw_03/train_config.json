{
  "model": "logreg",
  "hyperparams": {
    "C": 19.338816,
    "max_iter": 367,
    "class_weight": "balanced"
  },
  "preprocessing": {
    "impute": "mean",
    "scale": false,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "memory_limit_mb": 2048
}
