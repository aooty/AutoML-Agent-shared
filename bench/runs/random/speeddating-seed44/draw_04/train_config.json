{
  "model": "svc",
  "hyperparams": {
    "C": 0.003309,
    "kernel": "poly",
    "gamma": 0.007843,
    "class_weight": null
  },
  "preprocessing": {
    "impute": "median",
    "scale": true,
    "missing_indicator": true,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "memory_limit_mb": 2048
}
