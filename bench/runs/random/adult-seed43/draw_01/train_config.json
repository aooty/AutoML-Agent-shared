{
  "model": "gradient_boosting",
  "hyperparams": {
    "n_estimators": 429,
    "learning_rate": 0.000348,
    "max_depth": 64,
    "subsample": 0.198552
  },
  "preprocessing": {
    "impute": "mean",
    "scale": false,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/adult.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "memory_limit_mb": 2048
}
