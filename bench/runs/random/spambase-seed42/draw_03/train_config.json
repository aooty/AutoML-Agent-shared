{
  "model": "random_forest",
  "hyperparams": {
    "n_estimators": 1,
    "max_depth": 16,
    "min_samples_leaf": 4,
    "class_weight": null
  },
  "preprocessing": {
    "impute": "mean",
    "scale": true,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}
