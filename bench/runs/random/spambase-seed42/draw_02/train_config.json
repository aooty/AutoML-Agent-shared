{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 8,
    "learning_rate": 0.000134,
    "max_depth": 15,
    "reg_lambda": 33.700662,
    "subsample": 0.324063
  },
  "preprocessing": {
    "impute": "median",
    "scale": true,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}
