{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 12,
    "learning_rate": 0.171432,
    "max_depth": 47,
    "max_leaf_nodes": 42,
    "l2_regularization": 81.220664
  },
  "preprocessing": {
    "impute": "median",
    "scale": true,
    "missing_indicator": false,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}
