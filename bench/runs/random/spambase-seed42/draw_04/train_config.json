{
  "model": "xgboost",
  "hyperparams": {
    "n_estimators": 20,
    "learning_rate": 0.041932,
    "max_depth": 50,
    "reg_lambda": 71.524312,
    "subsample": 0.819039
  },
  "preprocessing": {
    "impute": "most_frequent",
    "scale": true,
    "missing_indicator": false,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 42,
  "memory_limit_mb": 2048
}
