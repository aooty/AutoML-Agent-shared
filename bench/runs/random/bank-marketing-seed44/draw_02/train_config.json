{
  "model": "extra_trees",
  "hyperparams": {
    "n_estimators": 35,
    "max_depth": 59,
    "min_samples_leaf": 12,
    "class_weight": "balanced"
  },
  "preprocessing": {
    "impute": "most_frequent",
    "scale": true,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "memory_limit_mb": 2048
}
