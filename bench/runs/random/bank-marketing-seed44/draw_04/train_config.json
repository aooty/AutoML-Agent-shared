{
  "model": "gradient_boosting",
  "hyperparams": {
    "n_estimators": 112,
    "learning_rate": 0.026129,
    "max_depth": 52,
    "subsample": 0.775198
  },
  "preprocessing": {
    "impute": "median",
    "scale": true,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "memory_limit_mb": 2048
}
