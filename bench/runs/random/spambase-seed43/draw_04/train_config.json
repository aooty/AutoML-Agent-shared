{
  "model": "svc",
  "hyperparams": {
    "C": 0.698497,
    "kernel": "poly",
    "gamma": 0.016278,
    "class_weight": "balanced"
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/spambase.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "memory_limit_mb": 2048
}
