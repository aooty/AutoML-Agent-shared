{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 2,
    "learning_rate": 0.006553,
    "max_depth": 50,
    "max_leaf_nodes": 2,
    "l2_regularization": 95.587836
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": true,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "memory_limit_mb": 2048
}
