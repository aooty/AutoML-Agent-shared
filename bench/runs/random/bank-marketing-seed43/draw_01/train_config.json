{
  "model": "mlp",
  "hyperparams": {
    "hidden_layer_sizes": [
      77
    ],
    "alpha": 4.6e-05,
    "learning_rate_init": 6.2e-05,
    "batch_size": 2984,
    "max_iter": 406
  },
  "preprocessing": {
    "impute": "most_frequent",
    "scale": true,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/bank-marketing.csv",
    "target_column": "Class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "memory_limit_mb": 2048
}
