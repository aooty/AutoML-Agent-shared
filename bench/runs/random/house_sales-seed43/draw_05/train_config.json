{
  "model": "knn",
  "hyperparams": {
    "n_neighbors": 114,
    "weights": "uniform"
  },
  "preprocessing": {
    "impute": "mean",
    "scale": true,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/house_sales.csv",
    "target_column": "price"
  },
  "metric": "r2",
  "task": "regression",
  "seed": 43,
  "memory_limit_mb": 2048
}
