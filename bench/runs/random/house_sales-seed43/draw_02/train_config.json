{
  "model": "extra_trees",
  "hyperparams": {
    "n_estimators": 30,
    "max_depth": 10,
    "min_samples_leaf": 13
  },
  "preprocessing": {
    "impute": "median",
    "scale": false,
    "missing_indicator": true,
    "missing_count": false
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/house_sales.csv",
    "target_column": "price"
  },
  "metric": "r2",
  "task": "regression",
  "seed": 43,
  "memory_limit_mb": 2048
}
