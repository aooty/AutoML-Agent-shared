{
  "model": "hist_gbdt",
  "hyperparams": {
    "max_iter": 1,
    "learning_rate": 0.031321,
    "max_depth": 38,
    "max_leaf_nodes": 11,
    "l2_regularization": 50.502066
  },
  "preprocessing": {
    "impute": "mean",
    "scale": false,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/speeddating.csv",
    "target_column": "match"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 43,
  "memory_limit_mb": 2048
}
