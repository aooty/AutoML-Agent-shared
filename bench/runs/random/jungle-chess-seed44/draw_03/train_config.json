{
  "model": "mlp",
  "hyperparams": {
    "hidden_layer_sizes": [
      251
    ],
    "alpha": 1e-06,
    "learning_rate_init": 0.029651,
    "batch_size": 6008,
    "max_iter": 130
  },
  "preprocessing": {
    "impute": "most_frequent",
    "scale": true,
    "missing_indicator": true,
    "missing_count": true
  },
  "target_missing": {
    "policy": "reject"
  },
  "data": {
    "path": "bench/data/jungle-chess.csv",
    "target_column": "class"
  },
  "metric": "balanced_accuracy",
  "task": "classification",
  "seed": 44,
  "memory_limit_mb": 2048
}
